{
  "openapi": "3.1.0",
  "info": {
    "title": "BuilderAd internal Goals contract",
    "version": "1.0.0",
    "description": "Native SPA Goals. Cookies and identity headers describe the WEB transport only. Not a mobile authentication design."
  },
  "paths": {},
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "builderad-session",
        "description": "Default advertiser cookie; SESSION_COOKIE may override it. Server SQL/Redis admission remains mandatory."
      },
      "documentReceipt": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Builderad-Document"
      },
      "transitionReceipt": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Builderad-Transition"
      }
    },
    "schemas": {
      "GoalValue": {
        "type": "object",
        "properties": {
          "goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": [
              "string",
              "null"
            ]
          },
          "results": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "goals",
          "priority",
          "results"
        ],
        "additionalProperties": false
      },
      "Preferences": {
        "type": "object",
        "properties": {
          "value": {
            "$ref": "#/components/schemas/GoalValue"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "value",
          "version"
        ],
        "additionalProperties": false
      },
      "SaveGoals": {
        "type": "object",
        "properties": {
          "value": {
            "$ref": "#/components/schemas/WriteGoalValue"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "value",
          "version"
        ],
        "additionalProperties": false
      },
      "WriteGoalValue": {
        "type": "object",
        "properties": {
          "goals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true
          },
          "priority": {
            "type": "string"
          },
          "results": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "required": [
          "goals",
          "priority",
          "results"
        ],
        "additionalProperties": false,
        "description": "Canonical SQL additionally requires exact catalog IDs, selected priority, results only for selected goals and results from the matching catalog. It normalizes ordering and empty results. Initial read may be empty/null; that state is not a valid write."
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "identityConflict": {
            "type": "boolean"
          },
          "code": {
            "type": "string",
            "enum": [
              "fresh_authentication_required"
            ]
          },
          "reauthenticate": {
            "type": "string",
            "enum": [
              "/internal/identity/switch",
              "/confirm-password"
            ]
          }
        },
        "required": [],
        "additionalProperties": true
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "message",
          "errors"
        ],
        "additionalProperties": false
      },
      "Visibility": {
        "type": "object",
        "properties": {
          "protected": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "context": {
            "type": "string"
          }
        },
        "required": [
          "protected",
          "path",
          "context"
        ],
        "additionalProperties": false
      },
      "GoalsWitness": {
        "type": "object",
        "properties": {
          "visibility": {
            "$ref": "#/components/schemas/Visibility"
          }
        },
        "required": [
          "visibility"
        ],
        "additionalProperties": false
      },
      "GoalsContext": {
        "type": "object",
        "properties": {
          "workspace": {
            "type": "object",
            "properties": {
              "public_id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "public_id",
              "name"
            ],
            "additionalProperties": false
          },
          "preferences": {
            "$ref": "#/components/schemas/Preferences"
          },
          "business": {
            "type": "object",
            "properties": {
              "type": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "name_ar": {
                        "type": "string"
                      },
                      "name_en": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name_ar",
                      "name_en"
                    ],
                    "additionalProperties": true
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "canManage": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "canManage"
            ],
            "additionalProperties": true
          },
          "catalog": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name_ar": {
                  "type": "string"
                },
                "name_en": {
                  "type": "string"
                },
                "description_ar": {
                  "type": "string"
                },
                "description_en": {
                  "type": "string"
                },
                "results": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name_ar": {
                        "type": "string"
                      },
                      "name_en": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "name_ar",
                      "name_en"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "name_ar",
                "name_en",
                "description_ar",
                "description_en",
                "results"
              ],
              "additionalProperties": false
            }
          },
          "visibility": {
            "$ref": "#/components/schemas/Visibility"
          }
        },
        "required": [
          "workspace",
          "preferences",
          "business",
          "catalog",
          "visibility"
        ],
        "additionalProperties": false
      }
    }
  }
}
